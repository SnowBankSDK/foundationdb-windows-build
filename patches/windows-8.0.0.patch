diff --git a/cmake/WindowsVersionInfo.rc.in b/cmake/WindowsVersionInfo.rc.in
new file mode 100644
index 0000000000..1617c6de2d
--- /dev/null
+++ b/cmake/WindowsVersionInfo.rc.in
@@ -0,0 +1,31 @@
+// Windows version resource, configured per target by fdb_windows_version_info() in CMakeLists.txt.
+#include <winver.h>
+
+VS_VERSION_INFO VERSIONINFO
+ FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
+ PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
+ FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
+ FILEFLAGS 0
+ FILEOS VOS_NT_WINDOWS32
+ FILETYPE @VI_FILETYPE@
+ FILESUBTYPE VFT2_UNKNOWN
+BEGIN
+  BLOCK "StringFileInfo"
+  BEGIN
+    BLOCK "040904b0"
+    BEGIN
+      VALUE "CompanyName", "FoundationDB project"
+      VALUE "FileDescription", "@VI_DESCRIPTION@"
+      VALUE "FileVersion", "@FDB_VERSION@"
+      VALUE "InternalName", "@VI_TARGET@"
+      VALUE "LegalCopyright", "Copyright Apple Inc. and the FoundationDB project authors. Apache License 2.0."
+      VALUE "OriginalFilename", "@VI_FILENAME@"
+      VALUE "ProductName", "FoundationDB"
+      VALUE "ProductVersion", "@FDB_VERSION@ (@CURRENT_GIT_VERSION@)"
+    END
+  END
+  BLOCK "VarFileInfo"
+  BEGIN
+    VALUE "Translation", 0x409, 1200
+  END
+END
