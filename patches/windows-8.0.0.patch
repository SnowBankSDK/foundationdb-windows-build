--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -29,6 +29,56 @@ project(foundationdb
   HOMEPAGE_URL "http://www.foundationdb.org/"
   LANGUAGES C CXX ASM)
 
+### HACKHACK FOR WIN32
+if(WIN32)
+	set(BOOST_ROOT "C:/boost_1_89_0")
+	set(BOOST_LIBRARYDIR "${BOOST_ROOT}/stage/lib")
+	# CompileBoost.cmake finds Boost in config mode on Windows: the staged BoostConfig.cmake lives under stage/lib/cmake.
+	list(APPEND CMAKE_PREFIX_PATH "${BOOST_ROOT}/stage")
+	set(Boost_USE_STATIC_LIBS ON)
+	set(Boost_USE_MULTITHREADED ON)
+	set(Boost_USE_STATIC_RUNTIME ON)
+	set(BUILD_C_BINDING ON)
+	
+	set(WITH_SWIFT OFF CACHE BOOL "Disable Swift on Windows")
+	set(CMAKE_Swift_COMPILER "" CACHE FILEPATH "Disable Swift compiler")
+	set(FOUNDATIONDB_CROSS_COMPILING OFF CACHE BOOL "Force cross-compiling to skip Swift targets")
+
+	set(OPEN_FOR_IDE OFF CACHE BOOL "Build from command line only on Windows")
+	
+	# simplify build
+	set(BUILD_DOCUMENTATION OFF CACHE BOOL "Don't build Sphinx Documentation on Windows")
+	set(BUILD_AWS_BACKUP OFF CACHE BOOL "No AWS backup support on Windows")
+	set(WITH_GRPC OFF CACHE BOOL "No gRPC support on Windows")
+	set(USE_VALGRIND OFF CACHE BOOL "No Valgrind")
+	set(BUILD_PYTHON_BINDING OFF CACHE BOOL "Do not build Python binding on Windows")
+	set(BUILD_JAVA_BINDING	OFF CACHE BOOL "Do not build JAVA binding on Windows")
+	set(BUILD_GO_BINDING OFF CACHE BOOL "Do not build Go binding on Windows")
+	set(BUILD_RUBY_BINDING OFF CACHE BOOL "Do not build Ruby binding on Windows")
+	set(WITH_ROCKSDB OFF CACHE BOOL "Disable RocksDB on Windows")
+	set(WITH_ACAC OFF CACHE BOOL "Disable ACAC on Windows")
+	set(NO_MULTIREGION_TEST ON CACHE BOOL "Disable Multi-Region Test on Windows")
+
+	# File and product version resource for the Windows binaries. The call is deferred to the end of this
+	# file, when the targets and FDB_VERSION exist.
+	function(fdb_windows_version_info)
+		foreach(spec "fdb_c|fdb_c.dll|FoundationDB C client library|VFT_DLL"
+		             "fdbcli|fdbcli.exe|FoundationDB command line interface|VFT_APP")
+			string(REPLACE "|" ";" spec "${spec}")
+			list(GET spec 0 VI_TARGET)
+			list(GET spec 1 VI_FILENAME)
+			list(GET spec 2 VI_DESCRIPTION)
+			list(GET spec 3 VI_FILETYPE)
+			if(TARGET ${VI_TARGET})
+				configure_file(${CMAKE_SOURCE_DIR}/cmake/WindowsVersionInfo.rc.in ${CMAKE_BINARY_DIR}/versioninfo/${VI_TARGET}.rc @ONLY)
+				target_sources(${VI_TARGET} PRIVATE ${CMAKE_BINARY_DIR}/versioninfo/${VI_TARGET}.rc)
+			endif()
+		endforeach()
+	endfunction()
+	cmake_language(DEFER CALL fdb_windows_version_info)
+endif()
+###
+
 if(WITH_SWIFT)
   enable_language(Swift)
 endif()
