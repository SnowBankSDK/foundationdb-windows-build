 int main(int argc, char** argv) {
+#ifdef _WIN32
+	// Windows hands main() its arguments in the ANSI code page, which loses characters outside it (in a
+	// cluster file path, for example). The rest of the client reads paths as UTF-8, so argv is rebuilt
+	// from the UTF-16 command line.
+	std::vector<std::string> utf8Args;
+	std::vector<char*> utf8Argv;
+	int wideArgc = 0;
+	if (wchar_t** wideArgv = CommandLineToArgvW(GetCommandLineW(), &wideArgc)) {
+		for (int i = 0; i < wideArgc; i++) {
+			utf8Args.push_back(platform::fromWidePath(wideArgv[i]));
+		}
+		LocalFree(wideArgv);
+		for (auto& arg : utf8Args) {
+			utf8Argv.push_back(arg.data());
+		}
+		utf8Argv.push_back(nullptr);
+		argc = wideArgc;
+		argv = utf8Argv.data();
+	}
+#endif
 	platformInit();
 	Error::init();
 	std::set_new_handler(&platform::outOfMemory);
