diff --git a/cmake/CompileActorCompiler.cmake b/cmake/CompileActorCompiler.cmake
index 2f737b617..7929a2a17 100644
--- a/cmake/CompileActorCompiler.cmake
+++ b/cmake/CompileActorCompiler.cmake
@@ -5,16 +5,32 @@ set(ACTORCOMPILER_SRCS
   ${CMAKE_CURRENT_SOURCE_DIR}/flow/actorcompiler/Program.cs
   ${CMAKE_CURRENT_SOURCE_DIR}/flow/actorcompiler/Properties/AssemblyInfo.cs)
 if(WIN32)
-  add_executable(actorcompiler ${ACTORCOMPILER_SRCS})
-  target_compile_options(actorcompiler PRIVATE "/langversion:6")
-  set_property(TARGET actorcompiler PROPERTY VS_DOTNET_REFERENCES
-    "System"
-    "System.Core"
-    "System.Xml.Linq"
-    "System.Data.DataSetExtensions"
-    "Microsoft.CSharp"
-    "System.Data"
-    "System.Xml")
+
+	# Paths
+	set(actorcompiler_proj "${CMAKE_SOURCE_DIR}/flow/actorcompiler/actorcompiler.csproj")
+	set(actor_out "${CMAKE_CURRENT_BINARY_DIR}/actorcompiler.exe")
+
+	# Custom command to build actorcompiler
+	add_custom_command(
+	  OUTPUT "${actor_out}"
+	  COMMAND dotnet build "${actorcompiler_proj}" -c Release -nologo -o "${CMAKE_CURRENT_BINARY_DIR}"
+	  BYPRODUCTS "${actor_out}"
+	  DEPENDS "${actorcompiler_proj}" ${ACTORCOMPILER_SRCS}
+	  COMMENT "Compile actor compiler"
+	  VERBATIM
+	)
+
+	# Custom target that builds actorcompiler
+	add_custom_target(actorcompiler_build DEPENDS "${actor_out}")
+
+	# Imported executable target
+	add_executable(actorcompiler IMPORTED GLOBAL)
+	set_target_properties(actorcompiler PROPERTIES IMPORTED_LOCATION "${actor_out}")
+	#add_dependencies(actorcompiler actorcompiler_build)
+
+	# Optional: expose path
+	set(actor_exe "$<TARGET_FILE:actorcompiler>")
+
 else()
   set(ACTOR_COMPILER_REFERENCES
     "-r:System,System.Core,System.Xml.Linq,System.Data.DataSetExtensions,Microsoft.CSharp,System.Data,System.Xml")
