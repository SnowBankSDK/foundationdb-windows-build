index 12882f9b33..48e9f89905 100644
--- a/flow/Platform.actor.cpp
+++ b/flow/Platform.actor.cpp
@@ -2944,8 +2944,36 @@ void setCloseOnExec(int fd) {
 } // namespace platform
 
 #ifdef _WIN32
+
+// The C runtime closes the handle of a _beginthread thread when the thread exits, so a later
+// waitThread() could wait on a closed or recycled handle. _beginthreadex returns a handle that stays
+// valid until waitThread() closes it. The wrapper reports an escaped exception before exiting.
+namespace {
+struct WindowsThreadArgs {
+	void (*func)(void*);
+	void* arg;
+};
+
+unsigned __stdcall runWindowsThread(void* a) {
+	std::unique_ptr<WindowsThreadArgs> args(static_cast<WindowsThreadArgs*>(a));
+	try {
+		args->func(args->arg);
+	} catch (std::exception& e) {
+		fprintf(stderr, "A side thread raised std::exception [%s]\n", e.what());
+		_exit(1);
+	}
+	return 0;
+}
+} // namespace
+
 THREAD_HANDLE startThread(void (*func)(void*), void* arg, int stackSize, const char* name) {
-	return (void*)_beginthread(func, stackSize, arg);
+	auto* args = new WindowsThreadArgs{ func, arg };
+	uintptr_t thread = _beginthreadex(nullptr, stackSize, &runWindowsThread, args, 0, nullptr);
+	if (thread == 0) {
+		delete args;
+		criticalError(FDB_EXIT_ERROR, "ThreadCreationError", strerror(errno));
+	}
+	return reinterpret_cast<THREAD_HANDLE>(thread);
 }
 #elif (defined(__linux__) || defined(__APPLE__) || defined(__FreeBSD__))
 THREAD_HANDLE startThread(void* (*func)(void*), void* arg, int stackSize, const char* name) {
@@ -2994,6 +3022,7 @@ THREAD_HANDLE startThread(void* (*func)(void*), void* arg, int stackSize, const
 void waitThread(THREAD_HANDLE thread) {
 #ifdef _WIN32
 	WaitForSingleObject(thread, INFINITE);
+	CloseHandle(thread);
 #elif (defined(__linux__) || defined(__APPLE__) || defined(__FreeBSD__))
 	pthread_join(thread, nullptr);
 #else
